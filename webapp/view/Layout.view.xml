                            	</m:VBox>
                       	    </f:SimpleForm>
                    		</m:VBox>
                    		<m:VBox width="25%">
                        		<f:SimpleForm editable="false"
                                      		  title="Phone Numbers"
                                              layout="ResponsiveGridLayout">
                            		<m:Label text="Mobile"/>
                            		<m:Text text="+91 9645621864"/>
                            		<m:Label text="Office Phone"/>
                            		<m:Text text="0471 271 0900"/>
                        		</f:SimpleForm>
                    		</m:VBox>
                    		<m:VBox width="25%">
                        		<f:SimpleForm editable="false"
                                      		  title="Mailing Address"
                                      		  layout="ResponsiveGridLayout">
                            		<m:Label text="Work"/>
                            		<m:Text text="joel.reji@applexus.com"/>
                            		<m:Label text="Personal"/>
                            		<m:Text text="joelreji@gmail.com"/>
                        		</f:SimpleForm>
                    		</m:VBox>
                    		<m:VBox width="25%">
                        		<f:SimpleForm editable="false"
                                      		  title="Personal Info"
                                      		  layout="ResponsiveGridLayout">
                            		<m:Label text="Gender"/>
                            		<m:Text text="Male"/>
                            		<m:Label text="Marital Status"/>
