<mvc:View controllerName="com.applexus.task.controller.Layout"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:m="sap.m"
    xmlns="sap.uxap"
    xmlns:l="sap.ui.layout"
	xmlns:f="sap.ui.layout.form">
    <m:Page id="page2" title="{i18n>title}">
        <ObjectPageLayout id="ObjectPageLayout"
		                  enableLazyLoading="true"
		                  beforeNavigate="onBeforeNavigate"
		                  useIconTabBar="true"
		                  showTitleInHeaderContent="true"
		                  upperCaseAnchorBar="false">
            <headerTitle>
			<ObjectPageDynamicHeaderTitle>
				<expandedHeading>
					<m:Title text="JOEL REJI" 
                             wrapping="true"/>
				</expandedHeading>

				<snappedHeading>
					<m:FlexBox fitContainer="true" 
                               alignItems="Center">
						<m:Avatar src="../images/image.jpg" 
                                  displaySize="L"
                                  class="sapUiTinyMarginEnd"/>
						<m:Title text="JOEL REJI" 
                                 wrapping="true" />
					</m:FlexBox>
				</snappedHeading>

				<expandedContent>
					<m:Text text="Trainee Consultant"/>
				</expandedContent>

				<snappedContent>
					<m:Text text="Trainee Consultant"/>
				</snappedContent>

				<snappedTitleOnMobile>
					<m:Title text="Trainee Consultant"/>
				</snappedTitleOnMobile>

				<actions>
					<m:Button text="Edit" 
                              type="Emphasized" 
                              press="onEdit"/>
					<m:OverflowToolbarButton icon="sap-icon://action" 
                                             type="Transparent" 
                                             text="Share" 
                                             tooltip="action"/>
				</actions>
			</ObjectPageDynamicHeaderTitle>
		</headerTitle>
		<headerContent>
			<m:FlexBox wrap="Wrap" 
					   fitContainer="true" >
				<m:Avatar class="sapUiSmallMarginEnd" 
						  src="../images/image.jpg" 
						  displaySize="M" />

				<l:VerticalLayout class="sapUiSmallMarginBeginEnd">
					<m:Link text="+91 9645621864" />
					<m:Link text="joelreji@gmail.com"/>
				</l:VerticalLayout>

				<l:HorizontalLayout class="sapUiSmallMarginBeginEnd">
					<m:VBox>
					<m:Image src="../images/linkedin.png"
					         width="20px"
							 height="20px"
							 class="sapUiSmallMarginBegin"/>
					<m:Image src="../images/twitter.png" 
							 width="20px"
							 height="20px"
					         class="sapUiSmallMarginBegin"/>
					</m:VBox>
			    </l:HorizontalLayout>
				<l:VerticalLayout class="sapUiSmallMarginBeginEnd">
					<m:Text text="Kazhakoottam, Thiruvananthapuram"/>
