                        		</f:SimpleForm>
                    		</m:VBox>
                			</m:HBox>
            			</blocks>
       			    </ObjectPageSubSection>
        			<ObjectPageSubSection id="PDS2" 
                              			  title="Social Accounts"
                             			  titleUppercase="false">
            			<blocks>
                			<m:HBox width="100%">
                    			<m:VBox width="50%">
                        			<f:SimpleForm editable="false"
                                      			  title="Social Accounts"
                                      			  layout="ResponsiveGridLayout">
                            			<m:Label text="LinkedIn"/>
                            			<m:Text text="linkedin.com/in/joelreji"/>
                            			<m:Label text="GitHub"/>
                            			<m:Text text="github.com/joelreji"/>
                        			</f:SimpleForm>
                    			</m:VBox>
                			</m:HBox>
            			</blocks>
            			<moreBlocks>
                			<m:HBox width="100%">
                    			<m:VBox width="50%">
                        			<f:SimpleForm editable="false"
