                                                  layout="ResponsiveGridLayout">
    									<m:FormattedText htmlText="&lt;ul&gt;
        									&lt;li&gt;Data Dictionary&lt;/li&gt;
       									    &lt;li&gt;ABAP Reports&lt;/li&gt;
        									&lt;li&gt;CDS&lt;/li&gt;
        									&lt;li&gt;OData&lt;/li&gt;
        									&lt;li&gt;Fiori&lt;/li&gt;
    									    &lt;/ul&gt;" />
									</f:SimpleForm>
                    			</m:VBox>
								<m:VBox width="50%">
									<f:SimpleForm editable="false"
												  title="Soft Skills"
                                                  layout="ResponsiveGridLayout">
										<m:Text text="• Team Player"/>
										<m:Text text="• Quick Learner"/>
										<m:Text text="• Time Management"/>
										<m:Text text="• Collaboration"/>
									</f:SimpleForm>
								</m:VBox>
