				<l:VerticalLayout class="sapUiSmallMarginBeginEnd">
    				<m:Text text="Department: SAP ABAP"/>
    				<m:Text text="Experience: 6 Months"/>
    				<m:Text text="Status: Active"/>
				</l:VerticalLayout>
			</m:FlexBox>
		</headerContent>
		<sections>
			<ObjectPageSection id="PD" 
