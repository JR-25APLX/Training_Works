			<ObjectPageSection id="EMP" 
                   			   title="Employment"
                   			   titleUppercase="false">
    			<subSections>
        			<ObjectPageSubSection >
            			<blocks>
                			<m:HBox width="100%">
                    			<m:VBox width="50%">
                        			<f:SimpleForm editable="false"
                                                  layout="ResponsiveGridLayout">
										<m:Label text="Company"/>
                            			<m:Text text="Applexus Technologies"/>
                            			<m:Label text="Role"/>
                            			<m:Text text="ABAP Consultant"/>
                            			<m:Label text="Date of Joining"/>
                            			<m:Text text="01 Dec 2025"/>
                            			<m:Label text="Total Experience"/>
                            			<m:Text text="4 Months"/>	
									</f:SimpleForm>
                    			</m:VBox>
								<m:VBox width="50%">
									<f:SimpleForm editable="false"
                                                  layout="ResponsiveGridLayout">
										<!-- <m:Label text="Company"/>
                            			<m:Text text="Applexus Technologies"/> -->
