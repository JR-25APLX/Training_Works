                			<m:HBox width="100%">
                    		<m:VBox width="25%">
                        	<f:SimpleForm editable="false"
                                      	  title="Addresses"
                                          layout="ResponsiveGridLayout">
                            	<m:Label text="Home Address"/>
                            	<m:VBox>
                                	<m:Text text="Melevila Veedu"/>
                                	<m:Text text="Kalayapuram, Kottarakkara"/>
                                	<m:Text text="PIN: 691560"/>
                            	</m:VBox>
                            	<m:Label text="Office Address"/>
                            	<m:VBox>
                                	<m:Text text="Applexus Technologies"/>
                                	<m:Text text="10, Yamuna Building"/>
