<mvc:View xmlns:form="sap.ui.layout.form" controllerName="com.applexus.task.controller.Emptable"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:t="sap.ui.table" 
    xmlns:c="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Page id="page1" title="{i18n>title}">
    <f:SimpleForm id='f1'>
        <f:content>
            <Label text="Employee ID"/>
            <Input width="200px" value = "{fiMo>empId}"/>
            <Label text="Employee Name"/>
            <Input width="200px" value = "{fiMo>empName}"/>
            <Label text="Employee Salary"/>
            <Input width="200px" value = "{fiMo>salary}"/>
        </f:content>
    </f:SimpleForm>

    <t:Table alternateRowColors="true"
             rows="{fiMo>/empTab}"
             selectionMode="Single"
             rowSelectionChange="onSelect">
        <t:columns>

            <t:Column width="100px">
            <t:label>
            <Label text="Employee ID"/>
            </t:label>
            <t:template>
            <Text text="{fiMo>empId}"/>
            </t:template>
            </t:Column>

            <t:Column width="130px">
            <t:label>
            <Label text="Employee Name"/>
            </t:label>
            <t:template>
            <Input value="{fiMo>empName}"/>
            </t:template>
            </t:Column>

            <t:Column >
            <t:label>
            <Label text="Date of Joining"/>
            </t:label>
            <t:template>
            <DatePicker
				value="{fiMo>doj}"
                displayFormat="dd-MM-yyyy"
				change="handleChange"
				class="sapUiSmallMarginBottom"/>
            </t:template>
            </t:Column>

            <t:Column width="100px">
            <t:label>
            <Label text="Salary"/>
            </t:label>
            <t:template>
            <Text text="{fiMo>salary}  {fiMo>currency}" />
            </t:template>
            </t:Column>
            
            <t:Column width="100px">
            <t:label>
            <Label text="Shift"/>
            </t:label>
            <t:template>
            <SegmentedButton selectedKey="{fiMo>shift}">
            <items>
            <SegmentedButtonItem key="mor" icon="sap-icon://light-mode" />
            <SegmentedButtonItem key="eve" icon="sap-icon://dark-mode" />
            </items>
            </SegmentedButton>
            </t:template>
            </t:Column>

            <t:Column width="75px">
            <t:label>
            <Label text="Gender"/>
            </t:label>
            <t:template>
            <Image src="{fiMo>gender}" width="30px"/>
            </t:template>
            </t:Column>

            <t:Column >
            <t:label>
            <Label text="Education"/>
            </t:label>
            <t:template>
            <Select selectedKey="{fiMo>education}" >
				<c:Item key="UG" text="UG" />
                <c:Item key="PG" text="PG" />
            </Select>
            </t:template>
            </t:Column>

            <t:Column width="120px">
            <t:label>
            <Label text="Marital Status"/>
            </t:label>
            <t:template>
            <Image src="{fiMo>mStatus}" width="30px"/>
            </t:template>
            </t:Column>

            <t:Column >
            <t:label>
            <Label text="Smoker"/>
            </t:label>
            <t:template>
            <CheckBox text="Yes" selected="{fiMo>smoker}" />
            </t:template>
            </t:Column>

            <t:Column >
            <t:label>
            <Label text="Rating"/>
            </t:label>
            <t:template>
            <RatingIndicator value="{fiMo>rating}" 
                             iconSize="20px" />
            </t:template>
            </t:Column>
            
        </t:columns>
    </t:Table>

    </Page>
</mvc:View>